{% extends 'base.html.twig' %}

{% block body %}
<header id="header" class="col-full header-nav">
    <div id="logo">
        <h1 class="site-title">The Shark</h1>
    </div>
    <nav id="site-navigation" class="main-navigation" role="navigation">
        <button class="menu-toggle" aria-controls="site-navigation" aria-expanded="false"></button>
        <div class="menu">
            <ul class="nav-menu">
                <li class="page_item"><a href="afficheRecherche">Rechercher un article</a></li>
                <li class="page_item current_page_item focus"><a href="accederAuPanier">Panier</a></li>
            </ul>
        </div>
    </nav>
</header>

<div class="col-full product-container">

    {# Colonne gauche : Images #}
    <div class="product-image-section">
        <img id="main-product-image" src="{{ asset(article.image) }}" alt="{{ article.titre }}" class="main-img">

        {% if article.imagesSupplementaires is defined and article.imagesSupplementaires is not empty %}
        <div class="gallery-container">
            <img src="{{ asset(article.image) }}" alt="Miniature" class="thumb-img"
                 onclick="document.getElementById('main-product-image').src=this.src;">

            {% for photo in article.imagesSupplementaires %}
                <img src="{{ asset(photo) }}" alt="Miniature" class="thumb-img"
                     onclick="document.getElementById('main-product-image').src=this.src;">
            {% endfor %}
        </div>
        {% endif %}
    </div>

    {# Colonne droite : Informations #}
    <div class="product-info-section">
        <h2 class="product-title">{{ article.titre }}</h2>

        {% if article.taille is defined and article.taille is not empty %}
            <p><strong>Taille :</strong> {{ article.taille }}</p>
        {% endif %}

        <p class="product-price">{{ article.prix }} €</p>

        <div class="shipping-box">
            <p><strong>Provenance :</strong> {{ article.lieuExpedition|default('Non précisé') }}</p>
            <p><strong>Délai de livraison :</strong> {{ article.delaiLivraison|default('Non précisé') }}</p>
        </div>

        <p><strong>Disponibilité :</strong> {{ article.disponibilite }} en stock</p>

        <form action="ajouterLigne" method="GET" class="cart-form">
            <input type="hidden" name="id" value="{{ article.id }}">
            <div class="qty-wrapper">
                <input type="number" name="qty" value="1" min="1" max="{{ article.disponibilite }}" class="qty-input">
            </div>
            <button type="submit" class="btn-add-cart">Ajouter au panier</button>
        </form>

        <a href="{{ path('afficheRecherche') }}" class="a-retour">&larr; Retour à la Recherche</a>
    </div>

    {# Recommandations #}
    {% if articlesSimilaires is defined and articlesSimilaires is not empty %}
    <div class="recommendations-section">
        <h3 style="text-align: center; margin-bottom: 20px;">Vous aimerez aussi</h3>
        <div class="rec-grid">
            {% for similaire in articlesSimilaires %}
                <div class="rec-card">
                    <a href="detailArticle?id={{ similaire.id }}" style="text-decoration: none; color: inherit;">
                        <img src="{{ asset(similaire.image) }}" alt="{{ similaire.titre }}" class="rec-img">
                        <h4 class="rec-title">{{ similaire.titre }}</h4>
                        <p style="font-weight: bold;">{{ similaire.prix }} €</p>
                    </a>
                </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
