{% extends 'base.html.twig' %}

{% block stylesheets %}
<link rel="stylesheet" href="/css/jplayer.css" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
<header id="header" class="col-full header-nav">
    <div id="logo">
        <a href="afficheRecherche">
            <h1 class="site-title">The Shark</h1>
        </a>
    </div>
    <nav id="site-navigation" class="main-navigation" role="navigation">
        <button class="menu-toggle" aria-controls="site-navigation" aria-expanded="false">
        </button>
        <div class="menu">
            <ul class="nav-menu">
                <li class="page_item page-item-1 current_page_item focus">
                    <a href="afficheRecherche">Rechercher
                        un article</a>
                </li>
                <li class="page_item page-item-2">
                    <a href="accederAuPanier">Panier</a>
                </li>
            </ul>
        </div>
    </nav>
</header>
<div id="content" class="site-content" tabindex="-1">
    <div class="col-full">
        <div id="primary">
            <main id="main" class="site-main" role="main">
                <header class="woocommerce-products-header">
                    <h1 class="woocommerce-products-header__title page-title"></h1>
                </header>

                <form method="GET" action="{{ path(app.request.attributes.get('_route')) }}"
                    style="margin-bottom: 20px; text-align: right;" class="sorting-form">

                    <select name="tri" class="orderby" onchange="this.form.submit()"
                        style="padding: 8px; border-radius: 4px; border: 1px solid #ccc;">
                        <option value="titre_asc" {% if app.request.query.get('tri')=='titre_asc' %}selected{% endif %}>
                            Trier par nom (A-Z)</option>
                        <option value="titre_desc" {% if app.request.query.get('tri')=='titre_desc' %}selected{% endif
                            %}>Trier par nom (Z-A)</option>
                        <option value="prix_asc" {% if app.request.query.get('tri')=='prix_asc' %}selected{% endif %}>
                            Trier par prix croissant</option>
                        <option value="prix_desc" {% if app.request.query.get('tri')=='prix_desc' %}selected{% endif %}>
                            Trier par prix décroissant</option>
                        <option value="stock_desc" {% if app.request.query.get('tri')=='stock_desc' %}selected{% endif
                            %}>Trier par disponibilité (+ au -)</option>
                        <option value="stock_asc" {% if app.request.query.get('tri')=='stock_asc' %}selected{% endif %}>
                            Trier par disponibilité (- au +)</option>
                    </select>
                </form>

                <ul class="products">
                    {% for article in articles %}
                        {% set class = '' %}
                        {% if loop.index0 is divisible by(3) %}{% set class = 'first' %}{% endif %}
                        {% if loop.index is divisible by(3) %}{% set class = 'last' %}{% endif %}

                        <li class="product {{ class }}"
                            onclick="window.location.href='detailArticle?id={{ article.id }}';"
                            style="cursor: pointer;">

                            <div class="type-product">
                                <div class="product-link">
                                    <img src="{{ asset(article.image) }}" class="product-img" alt="{{ article.titre }}" />
                                </div>

                                <div class="product-details-mobile">
                                    <h3>{{ article.titre }}</h3>

                                    <form action="ajouterLigne" method="GET" class="add-to-cart-form" onclick="event.stopPropagation();">
                                        <input type="hidden" name="id" value="{{ article.id }}">

                                        <div class="qty-wrapper">
                                            <span class="price">
                                                <ins><span class="amount">{{ article.prix }} €</span></ins>
                                            </span>
                                            <div>
                                                <label>Qté:</label>
                                                <input type="number" name="qty" value="1" min="1" max="{{ article.disponibilite }}">
                                            </div>
                                        </div>

                                        <button type="submit" class="add_to_cart_button">
                                            Ajouter au panier
                                        </button>
                                    </form>
                                </div>
                            </div>

                            {% if article.pistes is defined and article.pistes|length > 0 %}
                                <div id="jplayer_{{ article.id }}" class="jp-jplayer" onclick="event.stopPropagation();">
                                    <audio id="audio"></audio>
                                    <button class="prev-jplayer" id="prev"></button>
                                    <button class="play-jplayer" id="play"></button>
                                    <button class="next-jplayer" id="next"></button>
                                </div>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>

                {% if nombreDePages is defined and nombreDePages > 1 %}
                <nav class="woocommerce-pagination">
                    <ul class="page-numbers">

                        {% if page > 1 %}
                        <li>
                            <a class="page-numbers" href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'page': page - 1})) }}">&larr;</a>
                        </li>
                        {% endif %}

                        {% for i in range(1, nombreDePages) %}
                            {% if i == 1 or i == nombreDePages or (i >= page - 1 and i <= page + 1) %}
                                <li>
                                    {% if i == page %}
                                        <span class="page-numbers current">{{ i }}</span>
                                    {% else %}
                                        <a class="page-numbers" href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'page': i})) }}">{{ i }}</a>
                                    {% endif %}
                                </li>
                            {% elseif i == page - 2 or i == page + 2 %}
                                <li><span class="dots">...</span></li>
                            {% endif %}
                        {% endfor %}

                        {% if page < nombreDePages %}
                        <li>
                            <a class="page-numbers" href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'page': page + 1})) }}">&rarr;</a>
                        </li>
                        {% endif %}

                    </ul>
                </nav>
                {% endif %}
            </main>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script type="text/javascript" src="/js/jplayer.js"></script>
{% endblock %}
