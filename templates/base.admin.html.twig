<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Panel de contrôle{% endblock %}</title>
    <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}" />

    <link rel="stylesheet" href="/css/wordpress/wp-admin/load-styles.css" />
    <link rel="stylesheet" href="/css/plugins/woocommerce/packages/woocommerce-admin/dist/components/style.css"
        type="text/css" />
    <link rel="stylesheet" href="/css/plugins/woocommerce/packages/woocommerce-admin/dist/app/style.css"
        type="text/css" />
    <link rel="stylesheet" id="storefront-icons-css" href="/css/themes/storefront/assets/css/base/icons.css"
        type="text/css" />
    <link rel="stylesheet" href="/css/plugins/woocommerce/assets/css/admin.css" type="text/css" />

    <style id="symfony-form-css" type="text/css">
        /* ... vos styles existants ... */
        .woocommerce_options_panel div#form div {
            padding: 0;
            margin: 9px 0;
        }

        .woocommerce_options_panel,
        .woocommerce_options_panel input[type="email"],
        .woocommerce_options_panel input[type="number"],
        .woocommerce_options_panel input[type="password"],
        .woocommerce_options_panel input[type="text"] {
            width: 100%;
        }

        @media screen and (min-width: 500px) {
            .woocommerce_options_panel div#form div {
                padding: 5px 20px 35px 162px !important;
            }
        }

        /* Styles ajoutés pour le menu d'administration */
        .admin-top-nav {
            background: #fff;
            border: 1px solid #ccd0d4;
            padding: 10px 20px;
            margin-bottom: 20px;
            display: flex;
            gap: 20px;
            box-shadow: 0 1px 1px rgba(0, 0, 0, .04);
        }

        .admin-top-nav a {
            text-decoration: none;
            color: #2271b1;
            font-weight: 600;
        }

        .admin-top-nav a:hover {
            color: #135e96;
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>

<body class="woocommerce-embed-page">
    <div id="wpbody-content">
        <div class="wrap">

            {# --- DÉBUT DU MENU D'ADMINISTRATION AJOUTÉ ICI --- #}
            <nav class="admin-top-nav">
                <a href="{{ path('admin_utilisateurs') }}">Utilisateurs</a>
                <a href="{{ path('admin_produits') }}">Produits</a>
                <a href="{{ path('admin_commandes') }}">Voir les Commandes</a>

                <a href="/" style="margin-left: auto; color: #50575e;">🏠 Retour au site</a>
            </nav>
            {# --- FIN DU MENU --- #}

            {# Le contenu de vos pages s'insèrera ici (admin.musiques.html.twig, admin.utilisateurs.html.twig, etc.) #}
            {% block body %}{% endblock %}

            <script type="text/javascript" src="/js/themes/storefront/assets/js/navigation.min.js"></script>
            <script type="text/javascript" src="/js/jquery-3.6.3.min.js"></script>
            <script type="text/javascript" src="/js/admin.js"></script>
            {% block javascripts %}{% endblock %}

            <footer id="footer" class="col-full">
                <div id="credit" class="col-right">
                    <p>
                        Designed by
                        <a title="Premium WordPress Themes & Plugins by WooThemes"
                            alt="Premium WordPress Themes & Plugins by WooThemes" href="http://www.woothemes.com/">
                            <img width="74" height="19" alt="WooThemes" src="/images/woothemes.png">
                        </a>
                    </p>
                </div>
            </footer>
        </div>
    </div>
</body>

</html>