{% extends 'base.html.twig' %}
{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
{% endblock %}
{% block body %}
    <header id="header" class="col-full header-nav">
        <div id="logo">
            <a href="afficheRecherche">
                <h1 class="site-title">The Shark</h1>
            </a>
        </div>
        <nav id="site-navigation" class="main-navigation" role="navigation">
            <button class="menu-toggle" aria-controls="site-navigation" aria-expanded="false">
            </button>
            <div class="menu">
                <ul class="nav-menu">
                    <li class="page_item page-item-1">
                        <a href="afficheRecherche">Rechercher
                            un article</a>
                    </li>
                    <li class="page_item page-item-2 current_page_item focus">
                        <a href="accederAuPanier">Panier</a>
                    </li>
                    {% if app.user %}
                    {% if is_granted('ROLE_ADMIN') %}

                <li class="page_item">

                <a href="{{ path('admin_commandes') }}" style="color: #d9534f; font-weight: bold;">

                <i class="fa fa-lock"></i> Admin

                </a>

                </li>

                {% endif %}
                    <li class="page_item">
                        <a href="{{ path('app_profil') }}" style="font-weight: bold;"><i class="fa-solid fa-user"></i></a>
                        {% else %}
                    <li class="page_item">
                        <a href="{{ path('app_login') }}"><i class="fa-solid fa-user"></i></a>
                    </li>
                    {% endif %}
                </ul>
            </div>
        </nav>
    </header>
    <div id="content" class="col-full">
        <div id="main-sidebar-container">
            <header>
                <h1 class="title entry-title">Panier</h1>
            </header>
            <div class="woocommerce">
                <section class="entry">
                    <p class="cart-empty">Votre panier est vide.</p>
                </section>
            </div>
            <a href="afficheRecherche" class="button">
                Rechercher des articles
            </a>
        </div>
    </div>
{% endblock %}
