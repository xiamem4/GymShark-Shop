{% extends 'base.admin.html.twig' %}

{% block body %}
<div class="col-full" style="margin-top: 50px;">
    <h2>Gestion des Utilisateurs</h2>

    {# --- SECTION STATISTIQUES --- #}
    <div style="display: flex; gap: 20px; margin: 20px 0; font-family: sans-serif;">
        <div style="background: #fff; padding: 15px; border: 1px solid #ccd0d4; flex: 1; box-shadow: 0 1px 1px rgba(0,0,0,.04);">
            <span style="display: block; font-size: 0.9em; color: #646970;">Total</span>
            <strong style="font-size: 1.8em;">{{ nbTotal }}</strong>
        </div>
        <div style="background: #fff; padding: 15px; border: 1px solid #ccd0d4; flex: 1; border-left: 4px solid #00a32a; box-shadow: 0 1px 1px rgba(0,0,0,.04);">
            <span style="display: block; font-size: 0.9em; color: #646970;">Clients</span>
            <strong style="font-size: 1.8em; color: #00a32a;">{{ nbClients }}</strong>
        </div>
        <div style="background: #fff; padding: 15px; border: 1px solid #ccd0d4; flex: 1; border-left: 4px solid #d63638; box-shadow: 0 1px 1px rgba(0,0,0,.04);">
            <span style="display: block; font-size: 0.9em; color: #646970;">Administrateurs</span>
            <strong style="font-size: 1.8em; color: #d63638;">{{ nbAdmins }}</strong>
        </div>
    </div>

    <table class="shop_table" style="width: 100%; border-collapse: collapse; margin-top: 20px;">
        <thead>
            <tr style="border-bottom: 2px solid #ccc;">
                <th style="text-align: left; padding: 10px;">ID</th>
                <th style="text-align: left; padding: 10px;">Adresse Email</th>
                <th style="text-align: center; padding: 10px;">Rôles</th>
                <th style="text-align: center; padding: 10px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for user in utilisateurs %}
            <tr style="border-bottom: 1px solid #eee;">
                <td style="padding: 10px;">#{{ user.id }}</td>
                <td style="padding: 10px;">{{ user.email }}</td>
                <td style="padding: 10px; text-align: center;">
                    {# On affiche les rôles proprement #}
                    {% if 'ROLE_ADMIN' in user.roles %}
                    <span style="color: red; font-weight: bold;">Admin</span>
                    {% else %}
                    <span style="color: green;">Client</span>
                    {% endif %}
                </td>
                <td style="padding: 10px; text-align: center;">
                    <button class="button"
                        onclick="window.location.href='/admin/utilisateurs/modifier?id={{ user.id }}'">Modifier</button>

                    <button class="button" style="background: #b32d2e; color: white;"
                        onclick="if(confirm('Supprimer définitivement cet utilisateur ?')) window.location.href='/admin/utilisateurs/supprimer?id={{ user.id }}'">
                        Supprimer
                    </button>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="4" style="text-align: center; padding: 20px;">Aucun utilisateur trouvé.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}