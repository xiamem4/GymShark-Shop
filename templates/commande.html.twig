{% extends 'base.html.twig' %}

{% block body %}
    <header id="header" class="col-full">
        <div id="logo">
            <h1 class="site-title">The Shark</h1>
        </div>
    </header>

    <div class="col-full" style="margin-top: 50px;">
        <div style="text-align: center; margin-bottom: 40px;">
            <h2 style="color: #333;">Confirmation de votre commande</h2>
            <p style="font-size: 1.2em; color: green;">✅ Merci ! Votre commande a bien été enregistrée.</p>
        </div>

        <h3>Résumé de votre commande :</h3>
        <table class="shop_table" style="width: 100%; border-collapse: collapse; margin-bottom: 30px;">
            <thead>
                <tr style="border-bottom: 2px solid #ccc;">
                    <th style="text-align: left; padding: 10px;">Article</th>
                    <th style="text-align: center; padding: 10px;">Quantité</th>
                    <th style="text-align: right; padding: 10px;">Prix</th>
                </tr>
            </thead>
            <tbody>
                {% for ligne in panier.lignesPanier %}
                    <tr style="border-bottom: 1px solid #eee;">
                        <td style="padding: 10px;">{{ ligne.article.titre }}</td>
                        <td style="padding: 10px; text-align: center;">{{ ligne.quantite }}</td>
                        <td style="padding: 10px; text-align: right;">{{ ligne.prixUnitaire }} €</td>
                    </tr>
                {% endfor %}
            </tbody>
            <tfoot style="border-top: 2px solid #ccc;">
                <tr>
                    <th colspan="2" style="text-align: right; padding: 10px;">Sous-total :</th>
                    <td style="text-align: right; padding: 10px;">{{ panier.sousTotal }} €</td>
                </tr>
                <tr>
                    <th colspan="2" style="text-align: right; padding: 10px;">
                        Frais de port ({{ panier.tauxFraisPort }} %) :
                    </th>
                    <td style="text-align: right; padding: 10px;">{{ panier.montantFraisPort }} €</td>
                </tr>
                <tr>
                    <th colspan="2" style="text-align: right; padding: 20px 10px;">Total à régler :</th>
                    <th style="text-align: right; padding: 20px 10px; font-size: 1.4em; color: #111;">
                        {{ panier.total }} €
                    </th>
                </tr>
            </tfoot>
        </table>

        <div style="text-align: center; margin-top: 40px;">
            <a href="/" class="button" style="background-color: #333; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px;">
                Retour à l'accueil
            </a>
        </div>
    </div>
{% endblock %}