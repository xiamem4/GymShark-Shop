{# templates/admin.produits.html.twig #}
{% extends 'base.admin.html.twig' %}

{% block body %}
<div class="wrap">
    <h1 class="wp-heading-inline">Tableau de bord Produits</h1>

    {# --- SECTION STATISTIQUES --- #}
    <div style="display: flex; gap: 20px; margin: 20px 0;">
        <div style="background: #fff; padding: 15px; border: 1px solid #ccd0d4; flex: 1;">
            <span style="display: block; font-size: 0.9em; color: #646970;">Références totales</span>
            <strong style="font-size: 1.8em;">{{ nbProduitsDifferents }}</strong>
        </div>
        <div
            style="background: #fff; padding: 15px; border: 1px solid #ccd0d4; flex: 1; border-left: 4px solid #d63638;">
            <span style="display: block; font-size: 0.9em; color: #646970;">Produits en rupture</span>
            <strong style="font-size: 1.8em; color: #d63638;">{{ produitsARestock|length }}</strong>
        </div>
        <div
            style="background: #fff; padding: 15px; border: 1px solid #ccd0d4; flex: 1; border-left: 4px solid #2271b1;">
            <span style="display: block; font-size: 0.9em; color: #646970;">Valeur totale du stock</span>
            <strong style="font-size: 1.8em; color: #2271b1;">{{ valeurTotaleStock|number_format(2, ',', ' ') }}
                €</strong>
        </div>
    </div>

    {# --- ALERTE RESTOCK --- #}
    {% if produitsARestock is not empty %}
    <div style="background: #fcf0f1; border: 1px solid #d63638; padding: 15px; margin-bottom: 20px;">
        <h3 style="color: #d63638; margin-top: 0;">⚠️ Articles à restocker immédiatement :</h3>
        <ul>
            {% for p in produitsARestock %}
            <li><strong>{{ p.titre }}</strong> (ID: {{ p.id }})</li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}

    {# --- TABLEAU GLOBAL --- #}
    <table class="wp-list-table widefat">
        <thead>
            <tr>
                <th>Produit</th>
                <th>Type</th>
                <th>Prix Unitaire</th>
                <th>Stock</th>
                <th>Valeur Stock</th>
            </tr>
        </thead>
        <tbody>
            {% for produit in produits %}
            <tr>
                <td><strong>{{ produit.titre }}</strong></td>
                <td>{{ produit.typeNom }}</td>
                <td>{{ produit.prix }} €</td>
                <td {% if produit.disponibilite==0 %}style="color: red; font-weight: bold;" {% endif %}>
                    {{ produit.disponibilite }}
                </td>
                <td>{{ (produit.prix * produit.disponibilite)|number_format(2, ',', ' ') }} €</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}