{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="/css/jplayer.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
{% endblock %}

{% block title %}Mon Profil{% endblock %}

{% block body %}
<header id="header" class="col-full header-nav">
    <div id="logo">
        <h1 class="site-title" style="font-family: 'Bebas Neue', cursive;">The Shark</h1>
    </div>

    <nav id="site-navigation" class="main-navigation" role="navigation">
        <button class="menu-toggle" aria-controls="site-navigation" aria-expanded="false"></button>
        <div class="menu">
            <ul class="nav-menu">
                <li class="page_item"><a href="afficheRecherche">Rechercher un article</a></li>
                <li class="page_item current_page_item focus"><a href="accederAuPanier">Panier</a></li>
                {% if app.user %}
                {% if is_granted('ROLE_ADMIN') %}

                <li class="page_item">

                <a href="{{ path('admin_commandes') }}" style="color: #d9534f; font-weight: bold;">

                <i class="fa fa-lock"></i> Admin

                </a>

                </li>

                {% endif %}
                <li class="page_item">
                    <a href="{{ path('app_profil') }}" style="font-weight: bold;"><i class="fa-solid fa-user"></i></a>
                    {% else %}
                <li class="page_item">
                    <a href="{{ path('app_login') }}"><i class="fa-solid fa-user"></i></a>
                </li>
                {% endif %}
            </ul>
        </div>
    </nav>
</header>

<div class="container mt-5">
    <h1 class="title-reg">Mon Profil</h1>

    <div class="row mt-5">
        <div class="col-md-4">
            <div class="info-box">
                <h2 style="font-family: 'Bebas Neue', cursive; margin-bottom: 20px;">Mes coordonnées</h2>

                <div class="shark-reg-row">
                    <span class="shark-reg-label">Email</span>
                    <p>{{ user.email }}</p>
                </div>

                <div class="shark-reg-row">
                    <span class="shark-reg-label">Nom d'utilisateur</span>
                    <p>{{ user.nomUtilisateur ?? 'Non renseigné' }}</p>
                </div>

                <div class="shark-reg-row">
                    <span class="shark-reg-label">Nom / Prénom</span>
                    <p>{{ user.nom ?? '' }} {{ user.prenom ?? '' }}</p>
                </div>

                <div class="shark-reg-row">
                    <span class="shark-reg-label">Adresse de livraison</span>
                    <p style="color: #666;">{{ (user.adresseLivraison ?? 'Aucune adresse enregistrée')|nl2br }}</p>
                </div>

                <div style="margin-top: 30px;">
                    <a href="{{ path('app_logout') }}" class="btn-home" style="width: 100%; text-align: center;">
                        <i class="fa-solid fa-sign-out-alt"></i> Déconnexion
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div style="padding-left: 20px;">
                <h2 style="font-family: 'Bebas Neue', cursive;">Historique des commandes</h2>

                {% if user.commandes is empty %}
                    <p style="margin-top: 20px; color: #999;">Vous n'avez pas encore passé de commande sur The Shark.</p>
                {% else %}
                    <table class="order-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Référence</th>
                                <th class="text-center">Total</th>
                                <th>Articles</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for commande in user.commandes %}
                                <tr>
                                    <td>{{ commande.dateCreation|date('d/m/Y') }}</td>
                                    <td style="color: #edac61; font-weight: bold;">{{ commande.reference }}</td>
                                    <td class="text-center" style="font-weight: bold; color: #111;">{{ commande.total }} €</td>
                                    <td>
                                        <ul style="list-style: none; padding: 0; margin: 0; font-size: 0.9em; color: #666;">
                                            {% for ligne in commande.lignes %}
                                                <li><i class="fa-solid fa-caret-right" style="color: #edac61;"></i> {{ ligne.quantite }}x {{ ligne.article.titre }}</li>
                                            {% endfor %}
                                        </ul>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
